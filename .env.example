# GEMINI_API_KEY: Required for server-side Gemini AI assistant calls (Express server.ts & Netlify Functions).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY: Required for Google Maps Platform JavaScript SDK via /api/maps-config.
GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: Hosted application URL.
APP_URL="MY_APP_URL"
